--!strict
-- sprsonic: the chip's record and its use.
-- Generated by gen-content from the ROM; people own it now.

local lockon = require("../rules/lockon")
local parts = require("../lib/swords/parts")
local regions = require("@exelib/regions")
local slashes = require("../navis/megaman/forms/slash_cross/slashes")
local sonic = require("./sonic_boom/action")
local sword_slash_sprite = asset.sprite("sword_slash")

-- Its charged slash in SlashCross: WideSwrd's, over a column.
local CHARGED = slashes.slash {
    wave = slashes.wave { region = regions.wide, sprite = sword_slash_sprite, anim = 0 },
    blade = parts.blade,
    sound = parts.swing,
    lockon = lockon.wide_shot,
}

-- Its boom goes through (hit modifier 1). Charged in SlashCross it becomes
-- the charged slash its record's bytes read as (subtype 1, first parameter
-- 1): WideSwrd's after a dash.
local ACTION = sonic.action("super_sonic/action", { hit_mod = { flinch = true }, pierces = true }, { charged = CHARGED, step = true })

local chip: Chip = {
    codes = { "E", "L", "S", "*" },
    element = Element.null,
    family = Family.sword,
    class = ChipClass.special,
    rarity = 0,
    mb = 8,
    damage = 80,
    counter = 30,
    lockout = 0,
    flags = { has_damage = true, library = true },
    beast = { rush = false, lockon = lockon.super_sonic },
    slot_in_limit = 1,
    action = ACTION,
}

return { super_sonic = chip }
